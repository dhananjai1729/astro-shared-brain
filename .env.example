# LLM: anthropic | ollama | mock ; comma list = fallback chain, e.g. "anthropic,ollama"
LLM_PROVIDER=anthropic,ollama,demo   # demo = no-LLM fallback so the app always works; remove it to require a real model
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5-5
ANTHROPIC_EXTRACT_MODEL=claude-haiku-4-5
ANTHROPIC_CHAT_EFFORT=low
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain-pass
SQLITE_PATH=brain.db

# rules | laya
CLASSIFIER=rules
# background | inline
MEMORY_UPDATE_MODE=background
